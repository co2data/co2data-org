{
  "name": "co2data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "DB_URL=:memory: next build",
    "build:with-tests": "./scripts/coolify-build.sh",
    "start": "next start",
    "test": "vitest",
    "test:ci": "NODE_ENV=test DB_URL=:memory: vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "seed:e2e": "tsx scripts/seed-e2e-db.ts",
    "lint": "biome check app domain adapter lib",
    "lint:ci": "biome ci app domain adapter lib",
    "analyze-bundle-size": "ANALYZE=true next build",
    "db-migrate": "drizzle-kit generate",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {

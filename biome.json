{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/.direnv",
      "!**/.backup",
      "!**/public",
      "!**/next-env.d.ts",
      "!**/playwright-report",
      "!**/test-results",
      "!**/pnpm-lock.yaml"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noStaticOnlyClass": "off" },
      "correctness": { "noComponentHookFactories": "off" },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn"
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": { "mergeFunctions": ["cn"], "variantFunctions": ["cva"] }
}

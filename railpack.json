{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        {
          "cmd": "npm install -g --prefix /npmpnpm pnpm@8.10.5",
          "customName": "install pnpm on real node (native optional deps fix)"
        },
        { "path": "/npmpnpm/bin" },
        { "path": "/opt/pnpm" },
        { "cmd": "pnpm add -g node-gyp" },
        { "cmd": "mkdir -p /app/node_modules/.cache" },
        { "cmd": "pnpm install --frozen-lockfile --prefer-offline" },
        { "path": "/app/node_modules/.bin" }
      ]
    }
  }
}
